    {
      "parameters": {
        "jsonSchemaExample": "[\n  {\n    \"id\": 1,\n    \"first_frame\": \"Close-up of a young woman (random model) holding the Wasabi Knives Fixed Angle Sharpener towards the camera with a natural smile. Bright, clean kitchen background.\",\n    \"prompt\": \"Model explains how the sharpener works in 10 seconds, showing how to place the knife and demonstrating one smooth sharpening stroke.\",\n    \"dialog\": \"This sharpener fixes your knife’s angle automatically. Just place it in, slide once, and you’re done!\",\n    \"ugc_creator\": \"Male, 28\"\n  },\n  {\n    \"id\": 2,\n    \"first_frame\": \"Mid-shot of a random male model holding the sharpener casually in one hand and a dull knife in the other. Neutral, homey background.\",\n    \"prompt\": \"Model complains briefly about how dull their knife is, then uses the sharpener, showing a before-and-after cut through a tomato to highlight sharpness.\",\n    \"dialog\": \"Ugh, my knife can’t even cut this tomato. Watch this… one swipe… wow, razor-sharp again!\",\n    \"ugc_creator\": \"Female, 18\"\n  },\n  {\n    \"id\": 3,\n    \"first_frame\": \"Overhead shot of a random model placing the sharpener on a wooden kitchen counter with both hands visible, product centered and well-lit.\",\n    \"prompt\": \"Model demonstrates how easy it is to set up and use the sharpener, adding a quick voice line like 'Takes less than 10 seconds!'\",\n    \"dialog\": \"Set it down, slide the knife, and you’re ready to go. Takes less than 10 seconds!\",\n    \"ugc_creator\": \"Female, 35\"\n  }\n]\n"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
